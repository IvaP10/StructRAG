# ─────────────────────────────────────────────────────────────────────────────
# StructRAG configuration template.
#
#   cp key.env.example key.env    then fill in the real values.
#
# key.env is gitignored. Never commit it, and never put real keys in this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-your-openai-api-key"

# ── Vector database ──────────────────────────────────────────────────────────
# Defaults target a Qdrant on localhost:6333. In the Docker image, Qdrant runs
# in the same container, so these defaults are correct there too.
# QDRANT_HOST="localhost"
# QDRANT_PORT="6333"
# QDRANT_COLLECTION="documind_v2"
#
# To use Qdrant Cloud instead, set both of these. When QDRANT_API_KEY is
# present, QDRANT_HOST is treated as an https:// hostname and QDRANT_PORT is
# ignored (see database.py).
# QDRANT_HOST="your-cluster-id.region.aws.cloud.qdrant.io"
# QDRANT_API_KEY="your-qdrant-api-key"

# ── Server mode (only needed when running server/app.py) ─────────────────────
# Passphrase visitors type to unlock the hosted app. Pick something long.
INVITE_CODE="change-me-to-something-long-and-random"

# Signs session tokens. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
SESSION_SECRET="change-me-generate-a-random-value"

# Hard spending ceiling. When the day's estimated spend crosses this, every
# request returns 503 until UTC midnight. This is the real protection against
# a drained key.
DAILY_USD_CAP="0.70"

# Kill switch. Set to "1" to make every endpoint return 503 immediately.
DISABLED="0"

# Browser origins allowed to call the API. Comma-separated, no trailing slash.
# No default — the server refuses to start until this names your Pages URL.
ALLOWED_ORIGINS="https://<your-github-username>.github.io"

# ── Optional reranker microservice ───────────────────────────────────────────
# Leave empty to skip reranking and use raw RRF scores (retriever.py falls back
# gracefully). If set, it receives {"pairs":[{"query":..,"text":..}]} and must
# return {"scores":[...]}.
# RERANKER_API_URL=""
# RERANKER_API_KEY=""

# ── Tuning (all optional, defaults live in config.py) ────────────────────────
# LLM_MODEL="gpt-4o-mini"
# EMBEDDING_MODEL="text-embedding-3-large"
# LOG_LEVEL="WARNING"
